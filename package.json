{
  "name": "zettel",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "Local-first work management for people who make things",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist-desktop/main.cjs",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts",
    "start": "node --experimental-sqlite --import tsx server/index.ts",
    "mcp": "node --experimental-sqlite --import tsx server/mcp.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run build && npm run desktop:build && electron .",
    "desktop:package": "npm run build && npm run desktop:build && node scripts/license-notices.mjs && electron-builder --mac dmg zip --arm64 --publish never",
    "desktop:verify": "node scripts/verify-desktop-candidate.mjs",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dexie": "4.4.6",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "haus.zinnober.zettel",
    "productName": "Zettel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "dmg": {
      "title": "Install Zettel",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "dist-server/mcp.mjs",
        "to": "mcp.mjs"
      },
      {
        "from": "build/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "build/sbom.cdx.json",
        "to": "sbom.cdx.json"
      }
    ]
  }
}
